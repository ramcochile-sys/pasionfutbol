PORT=3000
CATALOG_ADMIN_USER=
CATALOG_ADMIN_HASH=
CATALOG_ADMIN_SALT=
CATALOG_ADMIN_USERS=
TBK_API_KEY_ID=
TBK_API_KEY_SECRET=
GOOGLE_MAPS_API_KEY=
# Configuración inicial del panel admin: secreto de 12+ caracteres que se pide en /admin/setup.
# Sin él (y sin CATALOG_ADMIN_*), la pantalla de configuración queda deshabilitada.
CATALOG_SETUP_CODE=
# Solo si el panel se muestra dentro de un iframe: 1 usa SameSite=None; Partitioned. Por defecto SameSite=Strict.
ADMIN_COOKIE_EMBEDDED=
# --- Vercel (los pone la integración de Turso al conectarla al proyecto) ---
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Solo para probar Blob fuera de Vercel; en Vercel se autentica solo (OIDC).
BLOB_READ_WRITE_TOKEN=
# Mercado Pago (Checkout Pro): Access Token de "Tus integraciones" > Credenciales.
# MP_WEBHOOK_SECRET es la clave secreta de la sección Webhooks (opcional, valida los avisos).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
